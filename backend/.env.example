# ClickSupply Environment Configuration

# App
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://clicksupply:clicksupply@localhost:5432/clicksupply

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ── Copilot SDK (for response analysis) ──
# All LLM analysis uses GitHub Copilot SDK. No API keys needed.
# Model to use via Copilot SDK (gpt-4.1, claude-sonnet-4.5, etc.)
COPILOT_MODEL=gpt-4.1

# Browser capture
PLAYWRIGHT_HEADLESS=true

# DPDPA
DATA_REGION=ap-south-1
